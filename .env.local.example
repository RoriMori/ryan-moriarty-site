# Sanity — copy this file to .env.local and fill in your values.
# Get these from https://sanity.io/manage → your project → Settings → API

NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id-here
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: read token for private datasets (leave blank for public datasets)
# SANITY_API_READ_TOKEN=your-token-here
